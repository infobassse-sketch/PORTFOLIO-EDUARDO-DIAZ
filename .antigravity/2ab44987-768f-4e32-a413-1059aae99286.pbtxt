    replacement_chunks {
      target_content: "export const PROPRIETARY_PROJECTS_DATA: ProprietaryProject[] = [\n  {\n    id: \'techno-experience\',\n    name: \'TECHNO EXPERIENCE\',\n    role: \'Co-Fundador y Director\',\n    description: \'Mi plataforma l\303\255der de divulgaci\303\263n sobre m\303\272sica de club, techno y lifestyle underground en Espa\303\261a y Latinoam\303\251rica, de la cual soy cofundador y codirector.\',\n    longDescription: \'Co-fund\303\251 y dirijo Techno Experience. Comenzamos como un simple canal de expresi\303\263n comunitaria y hemos madurado hasta convertirnos en una corporaci\303\263n editorial y promotora propia. Adem\303\241s de coordinar el contenido art\303\255stico, gu\303\255as de eventos y noticias premium, sirvo de soporte publicitario de alto rango e impulso la visibilidad de j\303\263venes talentos.\',\n    image: \'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=1200&auto=format&fit=crop\', // DJ mixer knobs & dark orange accent layout\n    tags: [\'MEDIO EDITORIAL\', \'SEO AGRESIVO\', \'TECHNO CULTURE\', \'COMMUNITY DRIVEN\', \'EVENT PROMOTION\'],\n    link: \'https://technoexperience.es\',\n    stats: [\n      { label: \'Lectores Mensuales\', value: \'80K+\' },\n      { label: \'Comunidad Redes\', value: \'120K+\' },\n      { label: \'Tr\303\241fico Org\303\241nico\', value: \'72%\' }\n    ]\n  },\n  {\n    id: \'bassse-agency\',\n    name: \'BASSSE\',\n    role: \'CEO y Fundador\',\n    description: \'Mi agencia creativa de direcci\303\263n de arte, desarrollo digital de alto rendimiento, estrategias de marketing y soluciones con IA aplicadas a proyectos culturales y de vanguardia.\',\n    longDescription: \'Fund\303\251 BASSSE para redefinir el significado de la ingenier\303\255a de marca en la industria musical y de ocio. Con mi equipo act\303\272o como el nexo perfecto entre la est\303\251tica underground de club y la conversi\303\263n comercial premium, integrando an\303\241lisis de datos, automatizaciones avanzadas mediante IA de vanguardia y drops de streetwear exclusivos.\',\n    image: \'https://images.unsplash.com/photo-1551434678-e076c223a692?q=80&w=1200&auto=format&fit=crop\', // Creative workspace, technical team, matching agency vibe\n    tags: [\'ESTRATEGIA DIGITAL\', \'DIRECCI\303\223N CREATIVA\', \'IA APLICADA\', \'CONSTRUCCI\303\223N DE MARCA\', \'EVENT MARKETING\'],\n    link: \'https://bassse.co\',\n    stats: [\n      { label: \'Proyectos Activos\', value: \'35+\' },\n      { label: \'Drops Hechos\', value: \'12\' },\n      { label: \'Retorno Medio\', value: \'+40%\' }\n    ]\n  },\n  {\n    id: \'sodoma-project\',\n    name: \'SODOMA\',\n    role: \'Director Creativo y Promotor\',\n    description: \'Mi serie de eventos de clubbing y mi colectivo underground enfocado en techno industrial, sonido de absoluta fidelidad y direcci\303\263n de arte extrema.\',\n    longDescription: \'Con Sodoma reconfiguro por completo la propuesta de club tradicional creando un espacio libre, seguro y sumamente inmersivo. Mi propuesta descansa en la provocaci\303\263n art\303\255stica, iluminaci\303\263n estrobosc\303\263pica implacable, pol\303\255tica estricta de no-fotos y una curadur\303\255a musical en la que congrego a los mayores exponentes de la escena techno industrial global.\',\n    image: \'https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?q=80&w=1200&auto=format&fit=crop\', // High power strobe club culture\n    tags: [\'DIRECCI\303\223N VISUAL\', \'CLUBBING RADICAL\', \'UNDERGROUND COMMUNITY\', \'PRODUCCI\303\223N ESTROBOSC\303\223PICA\', \'EXPERIENCIA SEGURA\'],\n    stats: [\n      { label: \'Tasa Sold Out\', value: \'94%\' },\n      { label: \'Fidelizaci\303\263n de Clubbers\', value: \'91%\' },\n      { label: \'Eventos Realizados\', value: \'8+\' }\n    ]\n  }\n];"
      replacement_content: "export const PROPRIETARY_PROJECTS_DATA: ProprietaryProject[] = [\n  {\n    id: \'techno-experience\',\n    name: \'TECHNO EXPERIENCE\',\n    role: \'Comunidad y medio de divulgaci\303\263n de cultura de club\',\n    description: \'Mi plataforma l\303\255der de divulgaci\303\263n sobre m\303\272sica de club, techno y lifestyle underground en Espa\303\261a y Latinoam\303\251rica, de la cual soy cofundador y codirector.\',\n    longDescription: \'Co-fund\303\251 y dirijo Techno Experience. Comenzamos como un simple canal de expresi\303\263n comunitaria y hemos madurado hasta convertirnos en una corporaci\303\263n editorial y promotora propia. Adem\303\241s de coordinar el contenido art\303\255stico, gu\303\255as de eventos y noticias premium, sirvo de soporte publicitario de alto rango e impulso la visibilidad de j\303\263venes talentos.\',\n    image: \'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=1200&auto=format&fit=crop\', // DJ mixer knobs & dark orange accent layout\n    tags: [\'MEDIO EDITORIAL\', \'SEO AGRESIVO\', \'TECHNO CULTURE\', \'COMMUNITY DRIVEN\', \'EVENT PROMOTION\'],\n    link: \'https://technoexperience.es\',\n    stats: [\n      { label: \'Lectores Mensuales\', value: \'80K+\' },\n      { label: \'Comunidad Redes\', value: \'120K+\' },\n      { label: \'Tr\303\241fico Org\303\241nico\', value: \'72%\' }\n    ]\n  },\n  {\n    id: \'bassse-agency\',\n    name: \'BASSSE\',\n    role: \'Agencia creativa, direcci\303\263n de arte e integraci\303\263n de IA\',\n    description: \'Mi agencia creativa de direcci\303\263n de arte, desarrollo digital de alto rendimiento, estrategias de marketing y soluciones con IA aplicadas a proyectos culturales y de vanguardia.\',\n    longDescription: \'Fund\303\251 BASSSE para redefinir el significado de la ingenier\303\255a de marca en la industria musical y de ocio. Con mi equipo act\303\272o como el nexo perfecto entre la est\303\251tica underground de club y la conversi\303\263n comercial premium, integrando an\303\241lisis de datos, automatizaciones avanzadas mediante IA de vanguardia y deejay systems.\',\n    image: \'https://images.unsplash.com/photo-1551434678-e076c223a692?q=80&w=1200&auto=format&fit=crop\', // Creative workspace, technical team, matching agency vibe\n    tags: [\'ESTRATEGIA DIGITAL\', \'DIRECCI\303\223N CREATIVA\', \'IA APLICADA\', \'CONSTRUCCI\303\223N DE MARCA\', \'EVENT MARKETING\'],\n    link: \'https://bassse.co\',\n    stats: [\n      { label: \'Proyectos Activos\', value: \'35+\' },\n      { label: \'Drops Hechos\', value: \'12\' },\n      { label: \'Retorno Medio\', value: \'+40%\' }\n    ]\n  },\n  {\n    id: \'sodoma-project\',\n    name: \'SODOMA\',\n    role: \'EVENTO de clubbing\',\n    description: \'Mi serie de eventos de clubbing y mi colectivo underground enfocado en techno industrial, sonido de absoluta fidelidad y direcci\303\263n de arte extrema.\',\n    longDescription: \'Con Sodoma reconfiguro por completo la propuesta de club tradicional creando un espacio libre, seguro y sumamente inmersivo. Mi propuesta descansa en la provocaci\303\263n art\303\255stica, iluminaci\303\263n estrobosc\303\263pica implacable, pol\303\255tica estricta de no-fotos y una curadur\303\255a musical en la que congrego a los mayores exponentes de la escena techno industrial global.\',\n    image: \'https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?q=80&w=1200&auto=format&fit=crop\', // High power strobe club culture\n    tags: [\'DIRECCI\303\223N VISUAL\', \'CLUBBING RADICAL\', \'UNDERGROUND COMMUNITY\', \'PRODUCCI\303\223N ESTROBOSC\303\223PICA\', \'EXPERIENCIA SEGURA\'],\n    stats: [\n      { label: \'Tasa Sold Out\', value: \'94%\' },\n      { label: \'Fidelizaci\303\263n de Clubbers\', value: \'91%\' },\n      { label: \'Eventos Realizados\', value: \'8+\' }\n    ]\n  }\n];"
